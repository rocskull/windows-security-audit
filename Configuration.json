{
  "FrameworkName": "Windows CIS Configuration Assessment Framework",
  "Version": "3.0.0",
  "SupportedPlatforms": [
    "Windows 7",
    "Windows 8",
    "Windows 8.1",
    "Windows 10",
    "Windows 11",
    "Windows Server 2008",
    "Windows Server 2012 R2",
    "Windows Server 2016",
    "Windows Server 2019",
    "Windows Server 2022",
    "Windows Server 2025"
  ],
  "AuditMode": "ReadOnly",
  "EnableSystemChanges": false,
  "IncludeDefenderBenchmark": false,
  "ReportFormats": [
    "HTML",
    "CSV",
    "JSON",
    "Excel"
  ],
  "LogFolder": "Logs",
  "ReportFolder": "Reports",
  "ModulesFolder": "Modules",
  "BenchmarksFolder": "Benchmarks",
  "Defaults": {
    "Severity": "Medium",
    "IncludeEvidence": true,
    "IncludeRecommendations": true,
    "ResultStatuses": [
      "PASS",
      "FAIL",
      "WARNING",
      "NOT APPLICABLE"
    ]
  },
  "Accounts": {
    "AllowedLocalAdministrators": [],
    "LastLogonWarningDays": 90
  },
  "Modules": []
}
