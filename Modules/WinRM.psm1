Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'SecurityAuditUtilities.psm1') -Force -ErrorAction Stop
function Invoke-Audit {[CmdletBinding()][OutputType([pscustomobject])]param();try{$s=Get-Service WinRM -ErrorAction Stop;$v=$s.Status;New-CISAuditFinding 'WRM-001' 'WinRM' 'Service' 'WinRM Enabled' 'Running only when authorized.' $v $(if($v -eq 'Running'){'WARNING'}else{'PASS'}) Medium "WinRM=$v" 'Disable WinRM when not required.'}catch{New-CISAuditFinding 'WRM-001' 'WinRM' 'Service' 'WinRM Enabled' 'Available' 'Unavailable' WARNING Medium $_.Exception.Message 'Verify WinRM service.'};try{$items=@(Get-ChildItem WSMan:\localhost\Listener -ErrorAction Stop);$a=$items|Out-String;New-CISAuditFinding 'WRM-002' 'WinRM' 'Listener' 'Listener' 'Listeners are reviewed.' $a PASS Medium $a 'Use HTTPS listeners and remove unnecessary listeners.';foreach($i in @(@('WRM-003','HTTP','Transport=HTTP'),@('WRM-004','HTTPS','Transport=HTTPS'))){New-CISAuditFinding $i[0] 'WinRM' 'Listener' $i[1] 'Listener configuration is reviewed.' $a PASS Medium $a 'Prefer HTTPS and restrict firewall access.'}}catch{foreach($i in @(@('WRM-002','Listener'),@('WRM-003','HTTP'),@('WRM-004','HTTPS'))){New-CISAuditFinding $i[0] 'WinRM' 'Listener' $i[1] 'Available' 'Unavailable' WARNING Medium $_.Exception.Message 'Verify WinRM configuration.'}};$base='WSMan:\localhost\Service';foreach($i in @(@('WRM-005','Authentication','Auth'),@('WRM-006','AllowUnencrypted','AllowUnencrypted'),@('WRM-007','TrustedHosts','Client\TrustedHosts'),@('WRM-008','Basic Authentication','Auth\Basic'),@('WRM-009','CredSSP','Auth\CredSSP'),@('WRM-010','Certificate Authentication','Auth\Certificate'))){try{$v=(Get-Item "$base\$($i[2])" -ErrorAction Stop).Value;New-CISAuditFinding $i[0] 'WinRM' 'Configuration' $i[1] 'Configured and reviewed.' ([string]$v) PASS Medium "$($i[2])=$v" 'Disable insecure authentication and unencrypted transport.'}catch{New-CISAuditFinding $i[0] 'WinRM' 'Configuration' $i[1] 'Available' 'Unavailable' WARNING Medium $_.Exception.Message 'Review WinRM configuration.'}}}
Export-ModuleMember -Function Invoke-Audit
