Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'SecurityAuditUtilities.psm1') -Force -ErrorAction Stop
function Invoke-Audit {[CmdletBinding()][OutputType([pscustomobject])]param();$edge='HKLM:\SOFTWARE\Policies\Microsoft\Edge';$settings=@(@('BROW-001','SmartScreen','SmartScreenEnabled'),@('BROW-002','Password Manager','PasswordManagerEnabled'),@('BROW-003','Insecure Password Warnings','PasswordMonitorAllowed'),@('BROW-004','Safe Browsing','SmartScreenEnabled'),@('BROW-005','Developer Tools','DeveloperToolsAvailability'),@('BROW-006','Extensions','ExtensionInstallBlocklist'),@('BROW-007','InPrivate Mode','InPrivateModeAvailability'),@('BROW-008','Download Restrictions','DownloadRestrictions'),@('BROW-009','Certificate Revocation','EnableOnlineRevocationChecks'),@('BROW-010','TLS Policies','SSLVersionMin'));foreach($s in $settings){$v=Get-CISRegistryValue $edge $s[2];$status=if($null -eq $v){'WARNING'}else{'PASS'};New-CISAuditFinding $s[0] 'Browser Security' 'Microsoft Edge' $s[1] 'Policy configured and reviewed.' ([string]$v) $status Medium ("Edge policy $($s[2])=$v") 'Configure the Edge enterprise policy according to organizational requirements.'};foreach($browser in @(@('BROW-011','Google Chrome','HKLM:\SOFTWARE\Policies\Google\Chrome','chrome.exe'),@('BROW-012','Mozilla Firefox','HKLM:\SOFTWARE\Policies\Mozilla\Firefox','firefox.exe'))){$installed=@(Get-ChildItem "$env:ProgramFiles*" -Filter $browser[3] -Recurse -ErrorAction SilentlyContinue|Select-Object -First 1).Count -gt 0;$exists=Test-Path $browser[2];New-CISAuditFinding $browser[0] 'Browser Security' $browser[1] "$($browser[1]) Policies" 'Policies are configured and reviewed when browser is installed.' $(if($exists){'Policy key present'}else{'Policy key absent'}) $(if(-not $installed){'NOT APPLICABLE'}elseif($exists){'PASS'}else{'WARNING'}) Low ("Installed=$installed; PolicyPath=$($browser[2])") 'Configure browser enterprise policies where the browser is deployed.'}}
Export-ModuleMember -Function Invoke-Audit
