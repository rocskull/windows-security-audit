Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'SecurityAuditUtilities.psm1') -Force -ErrorAction Stop
function Invoke-Audit {[CmdletBinding()][OutputType([pscustomobject])]param();try{$d=Get-CimInstance -Namespace root\Microsoft\Windows\DeviceGuard -ClassName Win32_DeviceGuard -ErrorAction Stop}catch{$d=$null};$props=@(@('DG-001','Virtualization Based Security','VirtualizationBasedSecurityStatus'),@('DG-002','Credential Guard','SecurityServicesRunning'),@('DG-003','HVCI','CodeIntegrityPolicyEnforcementStatus'),@('DG-004','Code Integrity','CodeIntegrityPolicyEnforcementStatus'),@('DG-005','Kernel DMA Protection','AvailableSecurityProperties'),@('DG-006','Secure Launch','SecurityServicesConfigured'));foreach($p in $props){$v=if($d){$d.($p[2])}else{$null};New-CISAuditFinding $p[0] 'Device Guard' 'Virtualization Based Security' $p[1] 'Enabled or available as required.' ([string]$v) $(if($null -eq $v){'WARNING'}else{'PASS'}) High "$($p[2])=$v" 'Enable and validate VBS/Device Guard features where hardware supports them.'}}
Export-ModuleMember -Function Invoke-Audit
